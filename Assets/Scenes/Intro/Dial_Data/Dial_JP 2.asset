--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: badcc343379a2484387c7e828270c449, type: 3}
  m_Name: Dial_JP 2
  m_EditorClassIdentifier: Assembly-CSharp::Dial
  scripts:
  - talker: "\u30B2\u30B9\u30C8"
    text: "\u3053\u3093\u306B\u3061\u306F\u3002\u3053\u3053\u306F\u672C\u5F53\u306B\u73CD\u3057\u3044\u3082\u306E\u304C\u305F\u304F\u3055\u3093\u3042\u308A\u307E\u3059\u306D\u3002"
  - talker: "\u30B2\u30B9\u30C8"
    text: "\u7279\u306B\u3042\u306E\u61D0\u4E2D\u6642\u8A08\u306F\u3001\u3059\u3054\u304F\u30EC\u30A2\u306A\u3082\u306E\u306A\u306E\u306B\u2026\u2026\u3002\n\u79C1\u304C\u305A\u3063\u3068\u524D\u306B\u6301\u3063\u3066\u3044\u305F\u3082\u306E\u3068\u3088\u304F\u4F3C\u3066\u3044\u307E\u3059\u306D\u3002"
  - talker: "\u30B2\u30B9\u30C8"
    text: "\u3042\u3001\u5B9F\u306F\u4ECA\u65E5\u3001\u7269\u3092\u58F2\u308A\u306B\u6765\u305F\u3093\u3067\u3059\u3002"
  - talker: "\u30B2\u30B9\u30C8"
    text: "\u3053\u306E\u7BB1\u306A\u3093\u3067\u3059\u3002\u3069\u308C\u304F\u3089\u3044\u53E4\u3044\u3082\u306E\u304B\u306F\u5206\u304B\u308A\u307E\u305B\u3093\u304C\u3001\n\u30AA\u30FC\u30AF\u30B7\u30E7\u30F3\u3067\u304B\u306A\u308A\u306E\u9AD8\u5024\u3067\u624B\u306B\u5165\u308C\u305F\u3082\u306E\u306A\u3093\u3067\u3059\u3002"
  - talker: "\u30B2\u30B9\u30C8"
    text: "\u4E2D\u306B\u4F55\u304C\u5165\u3063\u3066\u3044\u308B\u304B\u306F\u3001\u79C1\u3082\u958B\u3051\u3066\u3044\u306A\u3044\u306E\u3067\u5206\u304B\u308A\u307E\u305B\u3093\u3002\n\u7BB1\u304C\u305A\u3063\u3057\u308A\u3068\u3057\u3066\u3044\u308B\u306E\u3067\u3001\u4F55\u304B\u5165\u3063\u3066\u306F\u3044\u308B\u3088\u3046\u3067\u3059\u304C\u3002"
  - talker: "\u30B2\u30B9\u30C8"
    text: "\u3053\u3053\u3001\u7BB1\u306B\u523B\u307E\u308C\u305F\u6587\u5B57\u304C\u898B\u3048\u307E\u3059\u3088\u306D\uFF1F\u300C\u6C7A\u3057\u3066\u7BB1\u3092\u958B\u3051\u308B\u306A\u300D\u3063\u3066\u3002\n\u8AB0\u304B\u306E\u5358\u306A\u308B\u3044\u305F\u305A\u3089\u66F8\u304D\u304B\u3082\u3057\u308C\u307E\u305B\u3093\u304C\u2026\u2026\u306A\u3093\u3060\u304B\u6C17\u5473\u304C\u60AA\u304F\u3066\u3002"
  - talker: "\u30B2\u30B9\u30C8"
    text: "\u305D\u308C\u3067\u3001\u8CB7\u3044\u53D6\u3063\u3066\u3044\u305F\u3060\u3051\u307E\u3059\u304B\uFF1F"
  - talker: 
    text: "\uFF08\u304B\u306A\u308A\u9AD8\u4FA1\u305D\u3046\u306A\u54C1\u7269\u3060\u3002\uFF09"
  - talker: 
    text: "\u3048\u3048\u3001\u8CB7\u3044\u53D6\u308A\u307E\u3057\u3087\u3046\u3002"
  - talker: "\u30B2\u30B9\u30C8"
    text: "\u8CB7\u3044\u53D6\u3063\u3066\u304F\u308C\u3066\u3042\u308A\u304C\u3068\u3046\u3054\u3056\u3044\u307E\u3059\u3002\u4ECA\u5EA6\u307E\u305F\u4F55\u304B\u8CB7\u3044\u306B\u6765\u307E\u3059\u306D\u3002"
  - talker: 
    text: "\uFF08\u7BB1\u3092\u958B\u3051\u3066\u307F\u3088\u3046\u304B\uFF1F\uFF09"
