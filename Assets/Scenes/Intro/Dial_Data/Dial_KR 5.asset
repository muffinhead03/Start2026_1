--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: badcc343379a2484387c7e828270c449, type: 3}
  m_Name: Dial_KR 5
  m_EditorClassIdentifier: Assembly-CSharp::Dial
  scripts:
  - talker: 
    text: "\uB4DC\uB514\uC5B4 \uD0C8\uCD9C\uD588\uB124. \uCD95\uD558\uD574."
  - talker: 
    text: "\uC5B4\uB54C, \uC544\uC9C1\uB3C4 \uC774 \uBC29\uB4E4\uC774 \uB0AF\uC124\uC5B4?"
  - talker: 
    text: "\uADF8\uB798 \uB9DE\uC544. \uC774 \uBC29\uB4E4\uC740 \uB124\uAC00 \uBE7C\uC557\uC740
      \uBB3C\uAC74\uC758 \uC6D0\uB798 \uC8FC\uC778\uB4E4\uC774 \uC4F0\uB358 \uBC29\uB4E4\uC774\uC57C."
  - talker: 
    text: "\uADF8 \uC911\uC5D4 \uB0B4 \uBC29\uB3C4 \uC788\uC9C0."
  - talker: 
    text: "\uB10C \uADF8\uB0E5 \uD6D4\uCE58\uAE30\uB9CC \uD55C \uAC8C \uC544\uB2C8\uC57C.
      \uB124\uAC00 \uC5B4\uB5BB\uAC8C \uBB3C\uAC74\uC744 \uC190\uC5D0 \uB123\uC5C8\uB294\uC9C0,
      \uC5B4\uB5BB\uAC8C \uB2E4\uB978 \uC0AC\uB78C\uB4E4\uC5D0\uAC8C \uB4E4\uD0A4\uC9C0
      \uC54A\uC558\uB294\uC9C0 \uC0DD\uAC01\uD574\uBD10."
  - talker: 
    text: "\uB10C \uB124\uAC00 \uD55C \uC77C\uC744 \uB36E\uAE30 \uC704\uD574 \uB354
      \uB9CE\uC740 \uD76C\uC0DD\uC790\uB97C \uB9CC\uB4E4\uC5C8\uC9C0. \uADF8 \uD76C\uC0DD\uB2F9\uD55C
      \uC601\uD63C\uB4E4\uC740 \uBE7C\uC557\uAE34 \uC790\uC2E0\uC758 \uBB3C\uAC74\uC5D0
      \uBB36\uC5EC \uC9C0\uB09C \uBA87 \uC2ED\uB144\uAC04 \uBE60\uC838\uB098\uC62C
      \uC218 \uC5C6\uC5C8\uC5B4."
  - talker: 
    text: "\uC9C4\uC2E4\uC758 \uC0C1\uC790\uB97C \uC5F4\uC5C8\uC73C\uB2C8 \uC774\uC81C
      \uB108\uB3C4 \uB300\uAC00\uB97C \uCE58\uB7EC\uC57C \uD574. \uB124\uAC00 \uBE7C\uC557\uC740
      \uADF8\uB4E4\uC758 \uC2DC\uAC04\uB9CC\uD07C."
