  m_Script: {fileID: 11500000, guid: badcc343379a2484387c7e828270c449, type: 3}
  m_Name: Dial_EN 4
  m_EditorClassIdentifier: Assembly-CSharp::Dial
  scripts:
  - talker: 
    text: "Looks like you're finally awake. Listen carefully\u2014I'm trapped in
      here, just like you."
  - talker: 
    text: I've been here for a very long time. And then, out of nowhere, you appeared.
  - talker: 
    text: You can't see me, but I can see you. This walkie-talkie is the only way
      we can communicate.
  - talker: 
    text: So listen closely to what I say from now on. I can't touch or move anything.
      That means you have to open the door and get out on your own.
  - talker: 
    text: Now, you see the key and the box right in front of you? Use the key to
      open the box. Once it's open, the door will unlock too.
