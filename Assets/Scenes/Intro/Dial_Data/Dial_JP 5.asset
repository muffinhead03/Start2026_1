  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: badcc343379a2484387c7e828270c449, type: 3}
  m_Name: Dial_JP 5
  m_EditorClassIdentifier: Assembly-CSharp::Dial
  scripts:
  - talker: 
    text: "\u3084\u3063\u3068\u8131\u51FA\u3067\u304D\u305F\u306D\u3002\u304A\u3081\u3067\u3068\u3046\u3002"
  - talker: 
    text: "\u3069\u3046\u3060\u3044\u3001\u307E\u3060\u3053\u306E\u90E8\u5C4B\u306B\u898B\u899A\u3048\u306F\u306A\u3044\u304B\u3044\uFF1F"
  - talker: 
    text: "\u305D\u3046\u3001\u305D\u306E\u901A\u308A\u3002\u3053\u308C\u3089\u306E\u90E8\u5C4B\u306F\u3001\u304A\u524D\u304C\u596A\u3063\u305F\u54C1\u3005\u306E\u5143\u306E\u6301\u3061\u4E3B\u305F\u3061\u304C\u4F7F\u3063\u3066\u3044\u305F\u90E8\u5C4B\u3060\u3002"
  - talker: 
    text: "\u305D\u306E\u4E2D\u306B\u306F\u3001\u79C1\u306E\u90E8\u5C4B\u3082\u3042\u308B\u3002"
  - talker: 
    text: "\u304A\u524D\u306F\u305F\u3060\u76D7\u3093\u3060\u3060\u3051\u3058\u3083\u306A\u3044\u3002\u3069\u3046\u3084\u3063\u3066\u305D\u306E\u54C1\u3005\u3092\u624B\u306B\u5165\u308C\u305F\u306E\u304B\u3001\u3069\u3046\u3084\u3063\u3066\u4ED6\u306E\u9023\u4E2D\u306B\u30D0\u30EC\u305A\u306B\u6E08\u3093\u3060\u306E\u304B\u3001\u3088\u304F\u601D\u3044\u51FA\u3057\u3066\u307F\u308D\u3002"
  - talker: 
    text: "\u304A\u524D\u306F\u81EA\u5206\u306E\u60AA\u4E8B\u3092\u96A0\u3059\u305F\u3081\u306B\u3001\u3055\u3089\u306B\u591A\u304F\u306E\u72A0\u7272\u8005\u3092\u751F\u307F\u51FA\u3057\u305F\u3002\u72A0\u7272\u306B\u306A\u3063\u305F\u9B42\u305F\u3061\u306F\u596A\u308F\u308C\u305F\u81EA\u5206\u306E\u54C1\u306B\u7E1B\u308A\u4ED8\u3051\u3089\u308C\u3001\u3053\u306E\u4F55\u5341\u5E74\u3082\u306E\u9593\u3001\u629C\u3051\u51FA\u305B\u305A\u306B\u3044\u305F\u3093\u3060\u3002"
  - talker: 
    text: "\u771F\u5B9F\u306E\u7BB1\u3092\u958B\u3051\u305F\u306E\u3060\u304B\u3089\u3001\u4ECA\u5EA6\u306F\u304A\u524D\u304C\u4EE3\u511F\u3092\u6255\u3046\u756A\u3060\u3002\u304A\u524D\u304C\u5F7C\u3089\u304B\u3089\u596A\u3063\u305F\u3001\u305D\u306E\u6642\u9593\u306E\u5206\u3060\u3051\u306A\u3002"
