  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: badcc343379a2484387c7e828270c449, type: 3}
  m_Name: Dial_KR 4
  m_EditorClassIdentifier: Assembly-CSharp::Dial
  scripts:
  - talker: 
    text: "\uB4DC\uB514\uC5B4 \uC815\uC2E0\uC744 \uCC28\uB838\uB098\uBCF4\uAD70.
      \uC798 \uB4E4\uC5B4, \uB098 \uC5ED\uC2DC \uC790\uB124\uC640 \uBE44\uC2B7\uD558\uAC8C
      \uC5EC\uAE30\uC5D0 \uAC07\uD600\uC788\uB294 \uC0C1\uD0DC\uC57C."
  - talker: 
    text: "\uB09C \uC544\uC8FC \uC624\uB798 \uC804\uBD80\uD130 \uC5EC\uAE30 \uC788\uC5C8\uC5B4.
      \uADF8\uB7F0\uB370 \uAC11\uC790\uAE30 \uC790\uB124\uAC00 \uB098\uD0C0\uB09C
      \uAC70\uC57C."
  - talker: 
    text: "\uC790\uB124\uB294 \uB0A0 \uBCFC \uC218 \uC5C6\uACA0\uC9C0\uB9CC \uB09C
      \uC790\uB124\uB97C \uBCFC \uC218 \uC788\uC5B4. \uC6B0\uB9AC\uAC00 \uD1B5\uC2E0\uD560
      \uC218 \uC788\uB294 \uBC29\uBC95\uC740 \uBC14\uB85C \uC774 \uBB34\uC804\uAE30
      \uBFD0\uC774\uC57C."
  - talker: 
    text: "\uADF8\uB7EC\uB2C8\uAE4C \uC9C0\uAE08\uBD80\uD130 \uB0B4 \uB9D0 \uC798
      \uB4E3\uB3C4\uB85D \uD574. \uB098\uB294 \uBB3C\uCCB4\uB97C \uB9CC\uC9C8 \uC218\uB3C4,
      \uC6C0\uC9C1\uC77C \uC218\uB3C4 \uC5C6\uC5B4. \uC790\uB124 \uC2A4\uC2A4\uB85C
      \uBB38\uC744 \uC5F4\uACE0 \uB098\uAC00\uC57C \uD55C\uB2E4\uB294 \uB73B\uC774\uC9C0."
  - talker: 
    text: "\uC790 \uC9C0\uAE08 \uB208 \uC55E\uC5D0 \uC5F4\uC1E0\uC640 \uC0C1\uC790\uAC00
      \uBCF4\uC774\uC9C0? \uC5F4\uC1E0\uB85C \uC0C1\uC790\uB97C \uC5F4\uC5B4\uBD10.
      \uC0C1\uC790\uAC00 \uC5F4\uB9AC\uBA74 \uBB38\uB3C4 \uC5F4\uB9B4\uAC70\uC57C."
