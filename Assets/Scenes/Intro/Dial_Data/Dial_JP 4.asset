  m_Script: {fileID: 11500000, guid: badcc343379a2484387c7e828270c449, type: 3}
  m_Name: Dial_JP 4
  m_EditorClassIdentifier: Assembly-CSharp::Dial
  scripts:
  - talker: 
    text: "\u3084\u3063\u3068\u610F\u8B58\u304C\u623B\u3063\u305F\u3088\u3046\u3060\u306A\u3002\u3088\u304F\u805E\u3051\u3001\u79C1\u3082\u541B\u3068\u540C\u3058\u3088\u3046\u306B\u3053\u3053\u306B\u9589\u3058\u8FBC\u3081\u3089\u308C\u3066\u3044\u308B\u3093\u3060\u3002"
  - talker: 
    text: "\u79C1\u306F\u305A\u3063\u3068\u6614\u304B\u3089\u3053\u3053\u306B\u3044\u305F\u3002\u305D\u3053\u3078\u7A81\u7136\u3001\u541B\u304C\u73FE\u308C\u305F\u3093\u3060\u3002"
  - talker: 
    text: "\u541B\u306B\u79C1\u306E\u59FF\u306F\u898B\u3048\u306A\u3044\u3060\u308D\u3046\u304C\u3001\u79C1\u306B\u306F\u541B\u304C\u898B\u3048\u3066\u3044\u308B\u3002\u79C1\u305F\u3061\u304C\u9023\u7D61\u3092\u53D6\u308A\u5408\u3048\u308B\u624B\u6BB5\u306F\u3001\u3053\u306E\u30C8\u30E9\u30F3\u30B7\u30FC\u30D0\u30FC\u3060\u3051\u3060\u3002"
  - talker: 
    text: "\u3060\u304B\u3089\u4ECA\u304B\u3089\u8A00\u3046\u3053\u3068\u3092\u3088\u304F\u805E\u304F\u3093\u3060\u3002\u79C1\u306F\u7269\u306B\u89E6\u308C\u308B\u3053\u3068\u3082\u3001\u52D5\u304B\u3059\u3053\u3068\u3082\u3067\u304D\u306A\u3044\u3002\u3064\u307E\u308A\u3001\u541B\u81EA\u8EAB\u306E\u529B\u3067\u30C9\u30A2\u3092\u958B\u3051\u3066\u51FA\u308B\u3057\u304B\u306A\u3044\u3068\u3044\u3046\u3053\u3068\u3060\u3002"
  - talker: 
    text: "\u3055\u3042\u3001\u4ECA\u76EE\u306E\u524D\u306B\u9375\u3068\u7BB1\u304C\u898B\u3048\u308B\u3060\u308D\u3046\uFF1F\u9375\u3067\u7BB1\u3092\u958B\u3051\u3066\u307F\u308D\u3002\u7BB1\u304C\u958B\u3051\u3070\u3001\u30C9\u30A2\u3082\u958B\u304F\u306F\u305A\u3060\u3002"
