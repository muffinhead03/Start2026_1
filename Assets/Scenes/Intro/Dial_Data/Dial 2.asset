--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: badcc343379a2484387c7e828270c449, type: 3}
  m_Name: Dial 2
  m_EditorClassIdentifier: Assembly-CSharp::Dial
  scripts:
  - talker: "\uC190\uB2D8"
    text: "\uC548\uB155\uD558\uC138\uC694. \uC5EC\uAE34 \uCC38 \uD2B9\uC774\uD55C
      \uBB3C\uAC74\uB4E4\uC774 \uB9CE\uB124\uC694."
  - talker: "\uC190\uB2D8"
    text: "\uD2B9\uD788 \uC800 \uD68C\uC911\uC2DC\uACC4\uB294 \uC5C4\uCCAD \uD76C\uADC0\uD55C
      \uAC74\uB370\u2026 \uC81C\uAC00 \uC624\uB798 \uC804\uC5D0 \uAC00\uC9C0\uACE0
      \uC788\uC5C8\uB358 \uAC83\uACFC \uBE44\uC2B7\uD558\uB124\uC694."
  - talker: "\uC190\uB2D8"
    text: "\uC544, \uC800\uB294 \uC0AC\uC2E4 \uBB3C\uAC74\uC744 \uD314\uB7EC \uC654\uC5B4\uC694."
  - talker: "\uC190\uB2D8"
    text: " \uC774 \uC0C1\uC790\uC608\uC694. \uC5BC\uB9C8\uB098 \uC624\uB798\uB41C
      \uAC74\uC9C0\uB294 \uBAA8\uB974\uACA0\uB294\uB370 \uACBD\uB9E4\uC5D0\uC11C
      \uC544\uC8FC \uBE44\uC2F8\uAC8C \uC8FC\uACE0 \uAD6C\uD55C \uBB3C\uAC74\uC774\uC5D0\uC694."
  - talker: "\uC190\uB2D8"
    text: "\uC548\uC5D0 \uBB50\uAC00 \uB4E4\uC5B4\uC788\uB294\uC9C0\uB294 \uC800\uB3C4
      \uC548 \uC5F4\uC5B4\uBD10\uC11C \uBAA8\uB974\uACA0\uB124\uC694. \uC0C1\uC790\uAC00
      \uBB35\uC9C1\uD55C \uAC78 \uBD10\uC120 \uBB54\uAC00 \uB4E4\uC5B4\uC788\uB294
      \uAC83 \uAC19\uAE34 \uD55C\uB370."
  - talker: "\uC190\uB2D8"
    text: "\uC5EC\uAE30 \uC0C1\uC790\uC5D0 \uC0C8\uACA8\uC9C4 \uAE00\uC528\uAC00
      \uBCF4\uC774\uC2DC\uC8E0? \uC0C1\uC790\uB97C \uC808\uB300 \uC5F4\uC5B4\uBCF4\uC9C0
      \uB9D0\uB77C\uACE0. \uB204\uAD70\uAC00 \uADF8\uB0E5 \uB099\uC11C\uD55C \uAC78
      \uC218\uB3C4 \uC788\uB294\uB370\u2026 \uADF8\uB0E5 \uCC1D\uCC1D\uD558\uC796\uC544\uC694."
  - talker: "\uC190\uB2D8"
    text: "\uADF8\uB798\uC11C \uAD6C\uB9E4\uD558\uC2DC\uACA0\uC5B4\uC694?"
  - talker: 
    text: "(\uAF64 \uBE44\uC2F8\uBCF4\uC774\uB294 \uBB3C\uAC74\uC774\uB2E4.)"
  - talker: 
    text: "\uB124 \uADF8\uB7EC\uC8E0."
  - talker: "\uC190\uB2D8"
    text: "\uAD6C\uB9E4\uD574\uC918\uC11C \uACE0\uB9C8\uC6CC\uC694. \uB098\uC911\uC5D0
      \uB610 \uBB3C\uAC74 \uC0AC\uB7EC \uB4E4\uB97C\uAC8C\uC694."
